{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cu-medi-applicant-portal",
  "main": "src/index.ts",
  "compatibility_date": "2025-03-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/interested*",
      "/openhouse*",
      "/survey*",
      "/stage1*",
      "/stage2*",
      "/stage3*",
      "/portal*",
      "/dashboard*",
      "/intelligence*",
      "/api/*"
    ]
  },
  "vars": {
    "DATABASE_URL": "postgresql://neondb_owner:npg_N0ErUm5Bnxko@ep-hidden-truth-b37brfql-pooler.c-4.ap-southeast-1.aws.neon.tech/neondb?channel_binding=require&sslmode=require"
  }
}
